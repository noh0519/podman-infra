# LDAP directory identity used only when the cn=config volume is initialized
LDAP_BASE_DN=dc=bonohbh,dc=com
LDAP_ORGANIZATION=Bigo Corp
LDAP_ADMIN_DN=cn=admin,dc=bonohbh,dc=com
LDAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Initial user created only when the LDAP data volume is empty
LDAP_USER_UID=user1
LDAP_USER_CN=User One
LDAP_USER_SN=One
LDAP_USER_MAIL=user1@bonohbh.com
LDAP_USER_PASSWORD=replace-with-a-long-random-password

# Certificate subject/SAN used only when the TLS volume is empty
LDAP_HOSTNAME=ldap.bonohbh.com
