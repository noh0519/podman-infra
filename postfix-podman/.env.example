# Public DNS name of this SMTP server (A/AAAA and PTR should match).
MAIL_HOSTNAME=mail.bonohbh.com

# Space-separated domains accepted by this server.
MAIL_DOMAINS=mail.bonohbh.com

# Space-separated complete recipient addresses. Unknown recipients are rejected.
MAILBOXES=admin@mail.bonohbh.com postmaster@mail.bonohbh.com abuse@mail.bonohbh.com

# Dovecot login accounts in address={SCHEME}hash form, separated by spaces.
# Keep the entire value single-quoted so Compose treats '$' in hashes literally.
# Generate a hash with: openssl passwd -6
MAIL_USERS='admin@mail.bonohbh.com={SHA512-CRYPT}$6$replace-with-generated-hash'

# Optional space-separated aliases in source=destination form.
MAIL_ALIASES=postmaster@mail.bonohbh.com=admin@mail.bonohbh.com abuse@mail.bonohbh.com=admin@mail.bonohbh.com

# Trusted clients allowed to relay. Keep this narrow; never use 0.0.0.0/0.
MYNETWORKS=127.0.0.0/8 [::1]/128

# Maximum accepted message size in bytes (25 MiB here).
MESSAGE_SIZE_LIMIT=26214400

# Optional upstream relay. Leave RELAYHOST empty for direct Internet delivery.
# Example: [smtp.provider.example]:587
RELAYHOST=
RELAY_USERNAME=
RELAY_PASSWORD=

# TLS files are mounted from ./tls. If absent, inbound SMTP uses no TLS.
TLS_CERT_FILE=/etc/postfix/tls/fullchain.pem
TLS_KEY_FILE=/etc/postfix/tls/privkey.pem
